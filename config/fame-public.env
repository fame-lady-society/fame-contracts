BASE_FAME_ADDRESS=0xf307e242BfE1EC1fF01a4Cef2fdaa81b10A52418
BASE_FAME_NFT_ADDRESS=0xbb5ed04dd7b207592429eb8d599d103ccad646c4
BASE_CREATOR_ARTIST_MAGIC_ADDRESS=0xC8268c2aa571F3C88044C2959F73DdB8eB9e139F
BASE_CREATOR_ARTIST_MAGIC_CHILD_RENDERER_ADDRESS=0x8091D00A25ebE87A2A1Ef19e1d33689FCAdC3fA5
BASE_CREATOR_ARTIST_MAGIC_LEGACY_ADDRESS=0x8091D00A25ebE87A2A1Ef19e1d33689FCAdC3fA5
BASE_CREATOR_ARTIST_MAGIC_LEGACY_CHILD_RENDERER_ADDRESS=0xA50C9a918C110CA159fb187F4a55896A4d063878
BASE_FAME_BURN_POOL_ROTATOR_ADDRESS=0xC0e0A441660361ab2B6Ff8032Ed1860E230274bc
BASE_CLAIM_TO_FAME_ADDRESS=0xD6c1802eF7F59425F388764cA43C2e61c85A117A
BASE_FAME_VESTING_ADDRESS=0xf9301c6b2c6eF4F74f16d009C654097cbAdC95D2
