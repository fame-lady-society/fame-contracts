# Base Sepolia.
BASE_SEPOLIA_CHAIN_ID=84532
BASE_SEPOLIA_SWAP_ROUTER=0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4
BASE_SEPOLIA_WETH_ADDRESS=0x4200000000000000000000000000000000000006
