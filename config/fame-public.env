SEPOLIA_FAME_NFT_ADDRESS=0xF661Af827B0E89Bf24B933A12Da44F411ABAED56
SEPOLIA_FAME_ADDRESS=0xEaD0b62Deced7D0E56E4e3B13e246E183278CAEE

# Base mainnet.
