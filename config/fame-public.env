BASE_FAME_ROUTER_FEE_RECIPIENT=0xC952C53D8B63919e372caa2E6FEe605ee24E4D3D
BASE_FAME_ROUTER_FEE_PPM=2222
# Optional. When unset, router deployment leaves ownership with the deployer address
# derived from BASE_DEPLOYER_PRIVATE_KEY. Do not set to BASE_MULTISIG_ADDRESS until
# all launch gates pass.
# BASE_FAME_ROUTER_OWNER=
BASE_FAME_ROUTER_SCHEMA_VERSION=1
BASE_FAME_ROUTER_FIXTURE_SNAPSHOT_HASH=0x956774c7440cd09745a9763b19e89902a7be867f3b722a44e6dbb32cc8e44328
# Fill after deployment.
BASE_FAME_ROUTER_ADDRESS=0xAdefa5860389E8936ebf2977e1Fb4a365aA39636

# Universal Mint/Burn Pool art marketplace (Base).
BASE_UNIVERSAL_MARKETPLACE_DEPLOYER=0xD52E2A6bBcEba9673440e4D7843Db6713E9B6FD9
BASE_UNIVERSAL_MARKETPLACE_OWNER=0xD52E2A6bBcEba9673440e4D7843Db6713E9B6FD9
BASE_UNIVERSAL_MARKETPLACE_FEE_RECIPIENT=0xC952C53D8B63919e372caa2E6FEe605ee24E4D3D
# The production ownership script rejects every future owner except this Society Safe.
BASE_UNIVERSAL_MARKETPLACE_FUTURE_OWNER=0xC952C53D8B63919e372caa2E6FEe605ee24E4D3D
# Fee components are absolute FAME amounts. Each is 2.5% of the 1,000,000 FAME
# Society unit: 25,000 FAME to providers and 25,000 FAME to the community.
# The active-provider cap of 88 was selected after the passing latest-head Base
# benchmark recorded below.
BASE_UNIVERSAL_MARKETPLACE_COMMUNITY_FEE=25000000000000000000000
BASE_UNIVERSAL_MARKETPLACE_PROVIDER_FEE=25000000000000000000000
BASE_UNIVERSAL_MARKETPLACE_ACTIVE_PROVIDER_CAP=88
BASE_UNIVERSAL_MARKETPLACE_BENCHMARK_CANDIDATE_CAP=88
BASE_UNIVERSAL_MARKETPLACE_CHECKOUT_GAS_BUDGET=15000000
BASE_UNIVERSAL_MARKETPLACE_EXPECTED_PAUSED=true
# Fill only after the paused deployment is read back and validated.
# BASE_UNIVERSAL_MARKETPLACE_ADDRESS=
# BASE_FAME_MARKETPLACE_CHECKOUT_ADDRESS=

# CreatorArtistMagic V3 cutover (Base). These are the public manifest inputs;
# fill the three V3 outputs only after the live cutover receipts are recorded.
BASE_CREATOR_ARTIST_MAGIC_V3_PREVIOUS_ADDRESS=0xC8268c2aa571F3C88044C2959F73DdB8eB9e139F
BASE_CREATOR_ARTIST_MAGIC_V3_LEGACY_MARKETPLACE=0x54e7E4F2d439Be599706f51068f7EB2ce2D2a27e
BASE_CREATOR_ARTIST_MAGIC_V3_LEGACY_CHECKOUT=0x1905B4a633074243f3D9FDB59596fB7419adce2c
BASE_CREATOR_ARTIST_MAGIC_V3_OPERATOR=0xD52E2A6bBcEba9673440e4D7843Db6713E9B6FD9
# Public broadcast confirmations consumed by MigrateCreatorArtistMagicV3.
CREATOR_ARTIST_MAGIC_V3_CONFIRM_FAME=0xf307e242BfE1EC1fF01a4Cef2fdaa81b10A52418
CREATOR_ARTIST_MAGIC_V3_CONFIRM_V2=0xC8268c2aa571F3C88044C2959F73DdB8eB9e139F
CREATOR_ARTIST_MAGIC_V3_CONFIRM_OLD_MARKETPLACE=0x54e7E4F2d439Be599706f51068f7EB2ce2D2a27e
# Keep CREATOR_ARTIST_MAGIC_V3_EXECUTE and CREATOR_ARTIST_MAGIC_V3_BROADCAST
# as explicit command-scoped switches so sourcing this file stays read-only.
BASE_CREATOR_ARTIST_MAGIC_V3_CREATOR_1=0xF11Ce547ff948a03570B20Eac4a4d7b648693324
BASE_CREATOR_ARTIST_MAGIC_V3_CREATOR_2=0x750ea1c5ad297278665f2f8332a8876d6f95E19c
BASE_CREATOR_ARTIST_MAGIC_V3_CREATOR_3=0xaE30c908C41407877fE764B5f864eb0F5e536A72
BASE_CREATOR_ARTIST_MAGIC_V3_NEXT_TOKEN_ID=651
BASE_CREATOR_ARTIST_MAGIC_V3_ART_POOL_NEXT=266
# V3 deliberately retains V2's live totalNFTSupply boundary. It advances with
# fresh sequential mints but may move backward after burns, so classification
# of historically minted, currently unowned high IDs is best-effort.
BASE_CREATOR_ARTIST_MAGIC_V3_DN404_TOTAL_NFT_SUPPLY=564
# Migration-only private DN404 cursor observation. This rejects cutover drift;
# it must never be installed as CreatorArtistMagic Mint/Burn classifier state.
BASE_CREATOR_ARTIST_MAGIC_V3_DN404_PACKED_NEXT_TOKEN_ID=592
# No-broadcast transaction-sequence prediction. The migration rejects nonce
# drift and, once separately approved, asserts all three recorded outputs.
BASE_CREATOR_ARTIST_MAGIC_V3_OPERATOR_STARTING_NONCE=230
BASE_CREATOR_ARTIST_MAGIC_V3_PREDICTED_ADDRESS=0x6754e4871775A781702f2Ab6e494754a562586ee
BASE_UNIVERSAL_MARKETPLACE_V3_PREDICTED_ADDRESS=0x93222897902a5Fc2f20079d242c660117277930A
BASE_FAME_MARKETPLACE_CHECKOUT_V3_PREDICTED_ADDRESS=0x50B9649Aa28D7d0B966B2A51092C5BcF37905a63
# BASE_CREATOR_ARTIST_MAGIC_V3_ADDRESS=
# BASE_UNIVERSAL_MARKETPLACE_V3_ADDRESS=
# BASE_FAME_MARKETPLACE_CHECKOUT_V3_ADDRESS=

# CreatorArtistMagic (Base). Fill after confirming the deployed address.
# BASE_CREATOR_ARTIST_MAGIC_ADDRESS=
# Optional launch attestation when CreatorMagic ownership should be pinned.
# BASE_CREATOR_ARTIST_MAGIC_EXPECTED_OWNER=

