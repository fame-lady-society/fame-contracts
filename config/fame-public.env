# Deployment fails if the live renderer has drifted from this value.
BASE_SEPOLIA_EXPECTED_PREVIOUS_RENDERER=0x0000000000000000000000000000000000000000
# Pin immediately before deployment. Any submitted transaction makes a retry
# fail closed so a partial stack must be inspected instead of duplicated.
BASE_SEPOLIA_EXPECTED_DEPLOYER_NONCE=17
# The gallery owner, operator, and fee recipient are the pinned test deployer.
# Fill the deployed stack addresses immediately after deployment.
BASE_SEPOLIA_GALLERY_OWNER=0xD52E2A6bBcEba9673440e4D7843Db6713E9B6FD9
BASE_SEPOLIA_GALLERY_OPERATOR=0xD52E2A6bBcEba9673440e4D7843Db6713E9B6FD9
