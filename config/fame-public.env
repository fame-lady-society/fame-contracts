# Fill after deployment.
BASE_FAME_ROUTER_ADDRESS=0xAdefa5860389E8936ebf2977e1Fb4a365aA39636

# Closed-loop gallery swap.
# Fill CreatorMagic after confirming the deployed Base address.
# BASE_CREATOR_ARTIST_MAGIC_ADDRESS=
BASE_CLOSED_LOOP_GALLERY_FEE_RECIPIENT=0xC952C53D8B63919e372caa2E6FEe605ee24E4D3D
# Optional. When unset, gallery deployment leaves ownership with the deployer
# address derived from BASE_DEPLOYER_PRIVATE_KEY and uses the owner as operator.
# BASE_CLOSED_LOOP_GALLERY_OWNER=
# BASE_CLOSED_LOOP_GALLERY_OPERATOR=
# Optional launch attestation input for validation when CreatorMagic ownership
# should be pinned to a known admin or multisig.
# BASE_CREATOR_ARTIST_MAGIC_EXPECTED_OWNER=
# Fill after deployment.
# BASE_CLOSED_LOOP_GALLERY_ADDRESS=

# One-off Society NFT auction. Confirm all three public values before deployment/start.
